# =========================================================================
# RideTalk — Firebase Realtime Database Yapılandırması (ÖNERİLEN / 0 SUNUCU)
# Firebase Console > Project Settings > General kısmından Web App config değerlerini yapıştırın:
# =========================================================================
VITE_FIREBASE_API_KEY=AIzaSy...
VITE_FIREBASE_AUTH_DOMAIN=ridetalk-app.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://ridetalk-app-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=ridetalk-app
VITE_FIREBASE_STORAGE_BUCKET=ridetalk-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=1234567890
VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef123456

# =========================================================================
# (Opsiyonel) Harici Node.js WebSocket Sinyal Sunucusu
# Firebase kullanıyorsanız burayı boş bırakabilirsiniz.
# =========================================================================
VITE_SIGNALING_SERVER_URL=
